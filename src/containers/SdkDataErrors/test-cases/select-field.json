{
  "id": "select_field",
  "name": "Select Field — Single and Multiple",
  "description": "Tests setData on select/dropdown fields. Zod treats select as z.string().nullable() — does NOT validate against defined choices. Invalid choice values resolve at Zod layer.",
  "contentType": {
    "uid": "sdk_tc_select",
    "title": "SDK TC - Select Field",
    "description": "Module for SDK select field validation tests",
    "options": { "is_page": false, "singleton": false, "title": "title" },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": { "_default": true },
        "multiple": false
      },
      {
        "uid": "category",
        "data_type": "text",
        "display_name": "Category",
        "display_type": "dropdown",
        "mandatory": false,
        "unique": false,
        "field_metadata": { "description": "", "default_value": "" },
        "enum": {
          "advanced": false,
          "choices": [
            { "value": "tech" },
            { "value": "design" },
            { "value": "business" }
          ]
        },
        "multiple": false
      },
      {
        "uid": "tags_field",
        "data_type": "text",
        "display_name": "Tags",
        "display_type": "checkbox",
        "mandatory": false,
        "unique": false,
        "field_metadata": { "description": "", "default_value": "" },
        "enum": {
          "advanced": false,
          "choices": [
            { "value": "tech" },
            { "value": "design" },
            { "value": "business" }
          ]
        },
        "multiple": true
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Select Field Entry",
    "category": "tech",
    "tags_field": ["tech", "design"]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "category valid choice → resolves, no onError",
      "description": "Valid enum value 'tech'. Passes Zod string and CMS.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "category",
        "subscribeFieldOnErrorUid": "category",
        "data": "tech"
      },
      "expected": {
        "setData": { "outcome": "resolved" },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-002",
      "name": "category null → resolves, no onError",
      "description": "null clears the select field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "category",
        "subscribeFieldOnErrorUid": "category",
        "data": null
      },
      "expected": {
        "setData": { "outcome": "resolved" },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-003",
      "name": "category invalid choice → resolves (Zod: string), investigate CMS onError",
      "description": "'sports' is not a defined choice. Passes Zod z.string(). Investigate whether CMS form fires onError for invalid select value.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "category",
        "subscribeFieldOnErrorUid": "category",
        "data": "sports"
      },
      "expected": {
        "setData": { "outcome": "resolved" },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-004",
      "name": "category number → throws ValidationError (INVALID_TYPE)",
      "description": "Number fails Zod string schema for select.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "category",
        "subscribeFieldOnErrorUid": "category",
        "data": 42
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [{ "fieldUid": "category", "reasons": [{ "reason": "INVALID_TYPE" }] }]
          }
        },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-005",
      "name": "tags valid array → resolves, no onError",
      "description": "Valid array of enum values.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "tags_field",
        "subscribeFieldOnErrorUid": "tags_field",
        "data": ["tech", "design"]
      },
      "expected": {
        "setData": { "outcome": "resolved" },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-006",
      "name": "tags invalid choice in array → resolves (Zod: string), investigate CMS onError",
      "description": "'sports' in array passes Zod. Investigate whether CMS fires onError for invalid select in array.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "tags_field",
        "subscribeFieldOnErrorUid": "tags_field",
        "data": ["tech", "sports"]
      },
      "expected": {
        "setData": { "outcome": "resolved" },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-007",
      "name": "tags string not array → throws ValidationError (INVALID_TYPE)",
      "description": "Single string where array expected fails Zod for multiple select.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "tags_field",
        "subscribeFieldOnErrorUid": "tags_field",
        "data": "tech"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [{ "fieldUid": "tags_field", "reasons": [{ "reason": "INVALID_TYPE" }] }]
          }
        },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    },
    {
      "id": "TC-F-008",
      "name": "tags empty array → resolves, no onError",
      "description": "Empty array is valid for multiple select.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "tags_field",
        "subscribeFieldOnErrorUid": "tags_field",
        "data": []
      },
      "expected": {
        "setData": { "outcome": "resolved" },
        "fieldOnError": { "fired": false },
        "entryOnError": { "fired": false }
      }
    }
  ]
}
