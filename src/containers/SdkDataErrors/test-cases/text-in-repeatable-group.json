{
  "id": "text_in_repeatable_group",
  "name": "Text Field Inside Repeatable Group",
  "description": "Tests setData on a repeatable group (multiple:true) containing text fields. Row-indexed dotted paths (e.g. faq.0.question) appear in Zod errors.",
  "contentType": {
    "uid": "sdk_tc_text_rep_group",
    "title": "SDK TC - Text In Repeatable Group",
    "description": "Module for SDK text-in-repeatable-group validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "faq",
        "data_type": "group",
        "display_name": "FAQ",
        "mandatory": false,
        "unique": false,
        "multiple": true,
        "schema": [
          {
            "uid": "question",
            "data_type": "text",
            "display_name": "Question",
            "mandatory": false,
            "unique": false,
            "field_metadata": {},
            "multiple": false
          },
          {
            "uid": "answer",
            "data_type": "text",
            "display_name": "Answer",
            "mandatory": false,
            "unique": false,
            "field_metadata": {},
            "multiple": false
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Text In Repeatable Group Entry",
    "faq": [
      {
        "question": "What is this?",
        "answer": "A test entry."
      }
    ]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "faq valid single row → resolves, no onError",
      "description": "Valid array with one row. Passes all layers.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": [
          {
            "question": "What?",
            "answer": "This."
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "faq empty array → resolves, no onError",
      "description": "Empty array is valid for a repeatable group.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": []
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "faq null → resolves, no onError",
      "description": "null clears the repeatable group. Zod nullable allows it.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "faq question is number in row 0 → throws ValidationError (INVALID_TYPE faq.0.question)",
      "description": "Number for text child in row 0. Fails Zod. Error fieldUid includes row index.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": [
          {
            "question": 42,
            "answer": "x"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "faq.0.question",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-005",
      "name": "faq question is number in row 1 → throws ValidationError (INVALID_TYPE faq.1.question)",
      "description": "Valid row 0, number question in row 1. Error fieldUid reflects row index 1.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": [
          {
            "question": "ok",
            "answer": "fine"
          },
          {
            "question": 99,
            "answer": "also"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "faq.1.question",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-006",
      "name": "faq object not array → throws ValidationError (INVALID_TYPE faq)",
      "description": "Plain object where array is expected. Fails Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": {
          "question": "What?"
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "faq",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-007",
      "name": "faq string not array → throws ValidationError (INVALID_TYPE faq)",
      "description": "Plain string fails Zod array schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "faq",
        "subscribeFieldOnErrorUid": "faq",
        "data": "faq content"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "faq",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-E-001",
      "name": "entry.setData valid faq → resolves, no entryOnError",
      "description": "entry.setData with valid faq array. Passes all layers.",
      "operation": {
        "type": "entry-setdata",
        "data": {
          "faq": [
            {
              "question": "Why?",
              "answer": "Because."
            }
          ]
        },
        "subscribeFieldOnErrorUid": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-E-002",
      "name": "entry.setData faq type error in row → throws ValidationError",
      "description": "entry.setData with number question in row 0. Fails Zod.",
      "operation": {
        "type": "entry-setdata",
        "data": {
          "faq": [
            {
              "question": 42
            }
          ]
        },
        "subscribeFieldOnErrorUid": null
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "faq.0.question",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar"
}
