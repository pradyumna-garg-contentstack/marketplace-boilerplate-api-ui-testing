{
  "id": "file_field",
  "name": "File Field — Single and Multiple",
  "description": "Tests setData on file fields. Zod expects uid string(s) only — NOT asset objects. Passing a full asset object {uid, url, title} is the most common developer mistake.",
  "contentType": {
    "uid": "sdk_tc_file",
    "title": "SDK TC - File Field",
    "description": "Module for SDK file field validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "hero_image",
        "data_type": "file",
        "display_name": "Hero Image",
        "mandatory": false,
        "unique": false,
        "field_metadata": {},
        "multiple": false
      },
      {
        "uid": "gallery",
        "data_type": "file",
        "display_name": "Gallery",
        "mandatory": false,
        "unique": false,
        "field_metadata": {},
        "multiple": true
      }
    ]
  },
  "baseline": {
    "title": "SDK TC File Field Entry",
    "hero_image": "blt1234abcd5678ef00",
    "gallery": [
      "bltaaa111",
      "bltbbb222"
    ]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "hero_image valid uid string → resolves, no onError",
      "description": "Asset uid string. Passes Zod union(string, array).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "hero_image",
        "subscribeFieldOnErrorUid": "hero_image",
        "data": "blt1234abcd5678ef00"
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "hero_image null → resolves, no onError",
      "description": "null clears the file field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "hero_image",
        "subscribeFieldOnErrorUid": "hero_image",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "hero_image full asset object (common mistake) → throws ValidationError",
      "description": "Developers often pass the full asset object. Zod expects uid string only.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "hero_image",
        "subscribeFieldOnErrorUid": "hero_image",
        "data": {
          "uid": "blt1234abcd5678ef00",
          "url": "https://images.contentstack.io/v3/assets/blt.../hero.jpg"
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "hero_image",
                "reasons": [
                  {
                    "message": "Expected a valid file uid or an array of file uids"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "hero_image number → throws ValidationError (INVALID_TYPE)",
      "description": "Number fails Zod union(string, array).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "hero_image",
        "subscribeFieldOnErrorUid": "hero_image",
        "data": 42
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "hero_image",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-005",
      "name": "hero_image boolean → throws ValidationError (INVALID_TYPE)",
      "description": "Boolean fails Zod union(string, array).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "hero_image",
        "subscribeFieldOnErrorUid": "hero_image",
        "data": true
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "hero_image",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-006",
      "name": "gallery valid array of uid strings → resolves, no onError",
      "description": "Array of uid strings. Passes Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "gallery",
        "subscribeFieldOnErrorUid": "gallery",
        "data": [
          "bltaaa111",
          "bltbbb222"
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-007",
      "name": "gallery empty array → resolves, no onError",
      "description": "Empty array is valid.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "gallery",
        "subscribeFieldOnErrorUid": "gallery",
        "data": []
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-008",
      "name": "gallery single string (union accepts) → resolves, no onError",
      "description": "Zod union(string, array) accepts a single string for file fields.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "gallery",
        "subscribeFieldOnErrorUid": "gallery",
        "data": [
          "bltaaa111"
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-009",
      "name": "gallery array of asset objects → throws ValidationError",
      "description": "Array of full asset objects fails Zod — each item must be a string uid.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "gallery",
        "subscribeFieldOnErrorUid": "gallery",
        "data": [
          {
            "uid": "bltaaa111",
            "url": "https://..."
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "gallery",
                "reasons": [
                  {
                    "message": "Expected a valid file uid or an array of file uids"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-010",
      "name": "gallery nested array → throws ValidationError (INVALID_TYPE)",
      "description": "Array of arrays fails Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "gallery",
        "subscribeFieldOnErrorUid": "gallery",
        "data": [
          [
            "bltaaa111"
          ]
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "gallery",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ]
}