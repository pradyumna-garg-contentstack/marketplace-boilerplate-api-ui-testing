{
  "id": "text_constrained",
  "name": "Text Field — Length Constraints",
  "description": "Tests setData on a text field with min:5 and max:20. Tier-2: too short / too long resolve setData but fire field and entry onError. Tier-1: wrong type throws ValidationError (INVALID_TYPE) before onError.",
  "contentType": {
    "uid": "sdk_tc_text_const",
    "title": "SDK TC - Text Constrained",
    "description": "Module for SDK text length validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "short_text",
        "data_type": "text",
        "display_name": "Short Text",
        "mandatory": false,
        "unique": false,
        "field_metadata": {
          "description": "5 to 20 characters"
        },
        "multiple": false,
        "min": 5,
        "max": 20
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Text Constrained Entry",
    "short_text": "hello world"
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "short_text valid length (11 chars) → resolves, no onError",
      "description": "Within min:5 and max:20. Passes Zod and CMS.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "short_text",
        "subscribeFieldOnErrorUid": "short_text",
        "data": "hello world"
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "short_text too short (2 chars) → resolves, both onError",
      "description": "Passes Zod (string) but violates min length. CMS form fires onError.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "short_text",
        "subscribeFieldOnErrorUid": "short_text",
        "data": "hi"
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": true,
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text"
              }
            ]
          }
        },
        "entryOnError": {
          "fired": true,
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text"
              }
            ]
          }
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "short_text too long → resolves, both onError",
      "description": "String longer than max:20 passes Zod but violates max length.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "short_text",
        "subscribeFieldOnErrorUid": "short_text",
        "data": "this string exceeds max"
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": true,
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text"
              }
            ]
          }
        },
        "entryOnError": {
          "fired": true,
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text"
              }
            ]
          }
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "short_text number → throws ValidationError (INVALID_TYPE)",
      "description": "Number fails Zod text schema. setData throws; onError does not run.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "short_text",
        "subscribeFieldOnErrorUid": "short_text",
        "data": 123
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-E-001",
      "name": "entry.setData valid short_text → resolves, no entryOnError",
      "description": "Partial entry update with valid length.",
      "operation": {
        "type": "entry-setdata",
        "subscribeFieldOnErrorUid": null,
        "data": {
          "short_text": "hello world"
        }
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-E-002",
      "name": "entry.setData too short → resolves, entryOnError",
      "description": "entry.setData with value below min; entry onError aggregates field error.",
      "operation": {
        "type": "entry-setdata",
        "subscribeFieldOnErrorUid": null,
        "data": {
          "short_text": "hi"
        }
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": true,
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text"
              }
            ]
          }
        }
      }
    },
    {
      "id": "TC-E-003",
      "name": "entry.setData short_text wrong type → throws ValidationError",
      "description": "Number for text field fails Zod at entry.setData.",
      "operation": {
        "type": "entry-setdata",
        "subscribeFieldOnErrorUid": null,
        "data": {
          "short_text": 123
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "short_text",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar"
}
