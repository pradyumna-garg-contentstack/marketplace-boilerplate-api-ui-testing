{
  "id": "custom_extension_field",
  "name": "Custom Extension Field (JSON data_type)",
  "description": "Tests setData on a custom extension field (data_type:json with extension_uid). Zod applies generic JSON schema — accepts any array or object, but NOT primitives (string/number/boolean).",
  "contentType": {
    "uid": "sdk_tc_extension",
    "title": "SDK TC - Custom Extension Field",
    "description": "Module for SDK custom extension field validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "color_picker",
        "data_type": "json",
        "display_name": "Color Picker",
        "mandatory": false,
        "unique": false,
        "field_metadata": {
          "extension": true,
          "allow_json_rte": false
        },
        "multiple": false
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Custom Extension Field Entry",
    "color_picker": {
      "hex": "#0070f3",
      "rgba": "rgb(0,112,243)"
    }
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "color_picker valid object → resolves, no onError",
      "description": "Valid color object. Passes Zod union(array, record).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": {
          "hex": "#0070f3",
          "rgba": "rgb(0,112,243)"
        }
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "color_picker valid array form → resolves, no onError",
      "description": "Array form also accepted by Zod union(array, record).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": [
          "#0070f3",
          "#FF0000"
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "color_picker empty object → resolves, no onError",
      "description": "Empty object passes Zod record schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": {}
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-005",
      "name": "color_picker nested complex structure → resolves, no onError",
      "description": "Nested object passes Zod generic JSON schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": {
          "theme": {
            "primary": "#0070f3"
          },
          "dark": true
        }
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-006",
      "name": "color_picker string primitive → throws ValidationError",
      "description": "String fails Zod union(array, record) — primitives not accepted.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": "#0070f3"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "color_picker",
                "reasons": [
                  {
                    "message": "Expected a valid JSON value"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-007",
      "name": "color_picker number → throws ValidationError (INVALID_TYPE)",
      "description": "Number primitive fails Zod union(array, record).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": 16733170
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "color_picker",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-008",
      "name": "color_picker boolean → throws ValidationError (INVALID_TYPE)",
      "description": "Boolean primitive fails Zod union(array, record).",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "color_picker",
        "subscribeFieldOnErrorUid": "color_picker",
        "data": true
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "color_picker",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ]
}