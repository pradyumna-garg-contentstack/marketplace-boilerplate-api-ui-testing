{
  "id": "reference_field",
  "name": "Reference Field — Single and Multiple",
  "description": "Tests setData on reference fields. Zod validates {_content_type_uid, uid} shape and that _content_type_uid is allowed for the field (present in reference_to). Both single and array forms are accepted when valid.",
  "contentType": {
    "uid": "sdk_tc_reference",
    "title": "SDK TC - Reference Field",
    "description": "Module for SDK reference field validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "author_ref",
        "data_type": "reference",
        "display_name": "Author Reference",
        "mandatory": false,
        "unique": false,
        "field_metadata": {
          "ref_multiple": false
        },
        "reference_to": [
          "sdk_tc_reference"
        ],
        "multiple": false
      },
      {
        "uid": "related_posts",
        "data_type": "reference",
        "display_name": "Related Posts",
        "mandatory": false,
        "unique": false,
        "field_metadata": {
          "ref_multiple": true
        },
        "reference_to": [
          "sdk_tc_reference"
        ],
        "multiple": true
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Reference Field Entry",
    "author_ref": [
      {
        "_content_type_uid": "sdk_tc_reference",
        "uid": "self_uid"
      }
    ],
    "related_posts": [
      {
        "_content_type_uid": "sdk_tc_reference",
        "uid": "self_uid"
      }
    ]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "author_ref valid single object → resolves, no onError",
      "description": "Valid {_content_type_uid, uid} object. Passes Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "author_ref",
        "subscribeFieldOnErrorUid": "author_ref",
        "data": {
          "_content_type_uid": "sdk_tc_reference",
          "uid": "self_uid"
        }
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "author_ref valid as array → resolves, no onError",
      "description": "Array form of reference also passes Zod union.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "author_ref",
        "subscribeFieldOnErrorUid": "author_ref",
        "data": [
          {
            "_content_type_uid": "sdk_tc_reference",
            "uid": "self_uid"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "author_ref null → resolves, no onError",
      "description": "null clears the reference field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "author_ref",
        "subscribeFieldOnErrorUid": "author_ref",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "author_ref missing uid → throws ValidationError",
      "description": "Object without 'uid' key fails Zod reference shape validation.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "author_ref",
        "subscribeFieldOnErrorUid": "author_ref",
        "data": {
          "_content_type_uid": "sdk_tc_reference"
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "author_ref",
                "reasons": [
                  {
                    "message": "Reference must have a _content_type_uid and uid"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-005",
      "name": "author_ref missing _content_type_uid → throws ValidationError",
      "description": "Object without '_content_type_uid' key fails Zod reference shape validation.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "author_ref",
        "subscribeFieldOnErrorUid": "author_ref",
        "data": {
          "uid": "self_uid"
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "author_ref",
                "reasons": [
                  {
                    "message": "Reference must have a _content_type_uid and uid"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-006",
      "name": "author_ref plain string → throws ValidationError (INVALID_TYPE)",
      "description": "String fails Zod reference union schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "author_ref",
        "subscribeFieldOnErrorUid": "author_ref",
        "data": "bltabc123"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "author_ref",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-007",
      "name": "related_posts valid array → resolves, no onError",
      "description": "Valid array of reference objects.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "related_posts",
        "subscribeFieldOnErrorUid": "related_posts",
        "data": [
          {
            "_content_type_uid": "sdk_tc_reference",
            "uid": "self_uid"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-008",
      "name": "related_posts empty array → resolves, no onError",
      "description": "Empty array is valid.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "related_posts",
        "subscribeFieldOnErrorUid": "related_posts",
        "data": []
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-009",
      "name": "related_posts rejects _content_type_uid not in reference_to → ValidationError",
      "description": "Zod requires each reference’s _content_type_uid to be one of the field’s reference_to types. The second item uses a CT not allowed on related_posts, so setData throws VALIDATION_ERROR.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "related_posts",
        "subscribeFieldOnErrorUid": "related_posts",
        "data": [
          {
            "_content_type_uid": "sdk_tc_reference",
            "uid": "self_uid"
          },
          {
            "_content_type_uid": "any_other_content_type",
            "uid": "self_uid"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-010",
      "name": "related_posts item missing uid → throws ValidationError",
      "description": "Array item without uid fails Zod reference shape.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "related_posts",
        "subscribeFieldOnErrorUid": "related_posts",
        "data": [
          {
            "_content_type_uid": "sdk_tc_reference"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "related_posts",
                "reasons": [
                  {
                    "message": "Reference must have a _content_type_uid and uid"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ]
}