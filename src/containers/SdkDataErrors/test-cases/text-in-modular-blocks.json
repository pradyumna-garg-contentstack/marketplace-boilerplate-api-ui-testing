{
  "id": "text_in_modular_blocks",
  "name": "Text Field Inside Modular Blocks",
  "description": "Tests setData on a modular blocks field containing two block types (hero, card) with text subfields. Row-indexed dotted paths (e.g. sections.0.hero.heading) appear in Zod errors.",
  "contentType": {
    "uid": "sdk_tc_text_blocks",
    "title": "SDK TC - Text In Modular Blocks",
    "description": "Module for SDK text-in-modular-blocks validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "sections",
        "data_type": "blocks",
        "display_name": "Sections",
        "mandatory": false,
        "unique": false,
        "multiple": true,
        "blocks": [
          {
            "uid": "hero",
            "title": "Hero Block",
            "schema": [
              {
                "uid": "heading",
                "data_type": "text",
                "display_name": "Heading",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false,
                "min": 5
              },
              {
                "uid": "subheading",
                "data_type": "text",
                "display_name": "Subheading",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              }
            ]
          },
          {
            "uid": "card",
            "title": "Card Block",
            "schema": [
              {
                "uid": "label",
                "data_type": "text",
                "display_name": "Label",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              },
              {
                "uid": "body",
                "data_type": "text",
                "display_name": "Body",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              }
            ]
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Text In Modular Blocks Entry",
    "sections": [
      {
        "hero": {
          "heading": "Welcome here!",
          "subheading": null
        }
      }
    ]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "sections valid hero block → resolves, no onError",
      "description": "Single hero block with valid heading (≥5 chars). Passes all layers.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "hero": {
              "heading": "Welcome here!",
              "subheading": "Welcome here!"
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "sections valid card block → resolves, no onError",
      "description": "Single card block. No constraints violated.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "card": {
              "label": "Product A",
              "body": "Product A"
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "sections two blocks → resolves, no onError",
      "description": "Hero + card in sequence. Both valid.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "hero": {
              "heading": "Hi there!",
              "subheading": null
            }
          },
          {
            "card": {
              "label": "X",
              "body": null
            }
          },
          {
            "hero": {
              "heading": "Hi there!",
              "subheading": null
            }
          },
          {
            "card": {
              "label": "X",
              "body": null
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "sections null → resolves, no onError",
      "description": "null clears the blocks field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-005",
      "name": "sections empty array → resolves, no onError",
      "description": "Empty array is valid.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": []
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-007",
      "name": "sections hero heading is number → throws ValidationError (INVALID_TYPE)",
      "description": "Number for text heading. Fails Zod. Error path: sections.0.hero.heading.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "hero": {
              "heading": 123
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "sections.0.hero.heading",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-008",
      "name": "sections unknown block uid → throws ValidationError (INVALID_TYPE)",
      "description": "'banner' is not a registered block uid. Fails Zod blocks discriminator.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "banner": {
              "heading": "Hi"
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "sections.0",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-009",
      "name": "sections string not array → throws ValidationError (INVALID_TYPE)",
      "description": "String fails Zod array schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": "sections content"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "sections",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-010",
      "name": "sections object not array → throws ValidationError (INVALID_TYPE)",
      "description": "Plain object fails Zod array schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": {
          "hero": {
            "heading": "Hi there!"
          }
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "sections",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-011",
      "name": "sections error in row 1 → throws ValidationError (sections.1.hero.heading)",
      "description": "Row 0 valid card, row 1 hero heading is number. Error path includes row 1.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "card": {
              "label": "ok"
            }
          },
          {
            "hero": {
              "heading": 99
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "sections.1.hero.heading",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-012",
      "name": "sections two block keys in one row → throws ValidationError",
      "description": "Each row must have exactly one block uid key. Two keys fail Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections",
        "subscribeFieldOnErrorUid": "sections",
        "data": [
          {
            "hero": {
              "label": "X",
              "body": null
            }
          },
          {
            "card": {
              "heading": "Hi there!",
              "subheading": null
            }
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "sections.0.hero.heading",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              },
              {
                "fieldUid": "sections.0.hero.subheading",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              },
              {
                "fieldUid": "sections.1.card.label",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              },
              {
                "fieldUid": "sections.1.card.body",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar"
}