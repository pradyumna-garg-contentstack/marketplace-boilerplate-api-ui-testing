      }
    },
    {
      "id": "TC-F-009",
      "name": "categories object not array → throws ValidationError (INVALID_TYPE)",
      "description": "Plain object fails Zod array schema.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": {
          "taxonomy_uid": "taxonomy_testing1",
          "term_uid": "term_test1"
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
