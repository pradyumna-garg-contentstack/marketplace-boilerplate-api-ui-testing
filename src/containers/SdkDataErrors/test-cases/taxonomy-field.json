{
  "id": "taxonomy_field",
  "name": "Taxonomy Field",
  "description": "Tests setData on a taxonomy field. Zod validates array of {taxonomy_uid: string, term_uid: string} with looseObject (extra keys allowed). Wrong structure throws INVALID_TYPE.",
  "contentType": {
    "uid": "sdk_tc_taxonomy",
    "title": "SDK TC - Taxonomy Field",
    "description": "Module for SDK taxonomy field validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "taxonomies",
        "data_type": "taxonomy",
        "display_name": "Taxonomies",
        "mandatory": false,
        "unique": false,
        "multiple": true,
        "taxonomies": [
          {
            "taxonomy_uid": "taxonomy_testing1",
            "max_terms": 5,
            "mandatory": false,
            "non_localizable": false
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Taxonomy Field Entry",
    "taxonomies": []
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "categories valid item → resolves, no onError",
      "description": "Valid {taxonomy_uid, term_uid} item in array. Passes Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": [
          {
            "taxonomy_uid": "taxonomy_testing1",
            "term_uid": "term_test1"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "categories multiple items → resolves, no onError",
      "description": "Multiple valid taxonomy items.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": [
          {
            "taxonomy_uid": "taxonomy_testing1",
            "term_uid": "term_test1"
          },
          {
            "taxonomy_uid": "taxonomy_testing1",
            "term_uid": "term_test2"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "categories empty array → resolves, no onError",
      "description": "Empty array is valid.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": []
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "categories null → resolves, no onError",
      "description": "null clears the taxonomy field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-005",
      "name": "categories extra keys (looseObject) → resolves, no onError",
      "description": "Zod uses looseObject — extra keys beyond taxonomy_uid and term_uid are allowed.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": [
          {
            "taxonomy_uid": "taxonomy_testing1",
            "term_uid": "term_test1",
            "extra": "ok"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-006",
      "name": "categories missing taxonomy_uid → throws ValidationError (INVALID_TYPE)",
      "description": "Item without taxonomy_uid fails Zod required field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": [
          {
            "term_uid": "electronics"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "taxonomies.0.taxonomy_uid",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-007",
      "name": "categories missing term_uid → throws ValidationError (INVALID_TYPE)",
      "description": "Item without term_uid fails Zod required field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": [
          {
            "taxonomy_uid": "taxonomy_testing1"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "taxonomies.0.term_uid",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-008",
      "name": "categories string not array → throws ValidationError (INVALID_TYPE)",
      "description": "String fails Zod array schema for taxonomy.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "taxonomies",
        "subscribeFieldOnErrorUid": "taxonomies",
        "data": "electronics"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "taxonomies",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
