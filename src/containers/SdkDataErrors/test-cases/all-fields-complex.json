  "testCases": [
    {
      "id": "TC-A-001",
      "name": "Group A: entry.setData full valid payload → resolves, no onError",
      "description": "Happy path: entry.setData with complete valid data for all field types. Every field passes Zod and CMS validation.",
      "operation": {
        "type": "entry-setdata",
        "data": {
          "text_single": "Hello World",
          "text_multiple": [
            "react",
            "node"
          ],
          "number_single": 42,
          "number_multiple": [
            1,
            2,
            3
          ],
          "boolean_field": true,
          "date_single": "2025-06-15T00:00:00.000Z",
          "date_with_range": "2025-06-15T00:00:00.000Z",
          "file_single": "bltaaa111",
          "file_multiple": [
            "bltbbb222",
            "bltccc333"
          ],
          "link_field": {
            "href": "/home",
            "title": "Home"
          },
          "select_single": "opt_a",
          "select_multiple": [
            "tag_1",
            "tag_2"
          ],
          "group_single": {
            "sub_text": "hello",
            "sub_number": 10
          },
          "group_repeatable": [
            {
              "item_name": "Item One"
            }
          ],
          "modular_blocks_field": [
            {
              "text_section": {
                "content": "Hello world content"
              }
            }
          ],
          "taxonomies": [
            {
              "taxonomy_uid": "taxonomy_testing1",
              "term_uid": "term_test1"
            }
          ],
          "json_plain": "{\"key\":\"value\"}",
          "json_rte": {
            "type": "doc",
            "children": [
              {
                "text": "Hello"
              }
            ]
          },
          "markdown_field": "# Hello",
          "extension_field": {
            "color": "#0070f3"
          }
        },
        "subscribeFieldOnErrorUid": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-B-001",
      "name": "Group B: text_single type mismatch (number) → throws INVALID_TYPE",
      "description": "Number for text field fails Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "text_single",
        "subscribeFieldOnErrorUid": "text_single",
        "data": 123
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "text_single",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
