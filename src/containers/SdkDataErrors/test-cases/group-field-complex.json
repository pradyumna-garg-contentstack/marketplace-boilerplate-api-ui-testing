      "name": "contacts object not array → throws ValidationError (INVALID_TYPE contacts)",
      "description": "Plain object where repeatable group array expected fails Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "contacts",
        "subscribeFieldOnErrorUid": "contacts",
        "data": {
          "email": "x@x.com",
          "phone": "555"
        }
      },
      "expected": {
        "setData": {
