            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "profile",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
