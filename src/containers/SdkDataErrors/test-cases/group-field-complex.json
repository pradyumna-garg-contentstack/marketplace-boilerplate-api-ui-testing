        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-010",
      "name": "contacts valid array → resolves, no onError",
      "description": "Valid contacts array with proper email.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "contacts",
        "subscribeFieldOnErrorUid": "contacts",
        "data": [
          {
            "email": "user@example.com",
