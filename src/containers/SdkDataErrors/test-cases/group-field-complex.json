    {
      "id": "TC-F-008",
      "name": "profile avatar is full asset object → throws ValidationError (INVALID_TYPE profile.avatar)",
      "description": "Full asset object for file field fails Zod — expects uid string.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "profile",
        "subscribeFieldOnErrorUid": "profile",
        "data": {
          "name": "Jane",
          "avatar": {
            "uid": "bltaaa111",
            "url": "https://images.cs.io/v3/assets/blt..."
          }
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "profile.avatar",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-009",
      "name": "profile array not object → throws ValidationError (INVALID_TYPE profile)",
      "description": "Array fails Zod looseObject schema for group.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "profile",
        "subscribeFieldOnErrorUid": "profile",
        "data": [
          {
            "name": "Jane"
          }
        ]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
